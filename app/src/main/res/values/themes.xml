<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FewStep" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- The background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <!-- The icon displayed in the center of the splash screen -->
        <!-- We're using @drawable/logo which contains the 'FewStep' text for instant visibility -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <!-- The theme to use AFTER the splash screen is dismissed -->
        <item name="postSplashScreenTheme">@style/Theme.FewStep</item>
    </style>
</resources>