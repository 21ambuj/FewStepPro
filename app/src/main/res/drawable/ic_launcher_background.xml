<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Deep Indigo Base with Radial Glow -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient 
                android:centerX="54" android:centerY="54"
                android:gradientRadius="70"
                android:type="radial">
                <item android:color="#283593" android:offset="0.0" />
                <item android:color="#1A237E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Diagonal Glass Highlight (Top Left) -->
    <path
        android:fillColor="#ffffff"
        android:fillAlpha="0.08"
        android:pathData="M0,0 L108,0 L0,108 Z" />

    <!-- Subtle Diagonal Inner Shadow (Bottom Right) -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.05"
        android:pathData="M108,108 L0,108 L108,0 Z" />

    <!-- Corner Ambient Glow Effect (Top Right) -->
    <path android:pathData="M80,0 Q100,0 108,20 L108,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient 
                android:startX="80" android:startY="0"
                android:endX="108" android:endY="20"
                android:type="linear">
                <item android:color="#3F51B5" android:offset="0.0" />
                <item android:color="#1A237E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
